{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "bin": {
            "type": "string",
            "pattern": "^[0-9]{1,16}$"
        },
        "amount": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{2})?$"
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3,4}$"
        }
    },
    "required": [
        "bin",
        "amount",
        "currency"
    ],
    "additionalProperties": false
}
